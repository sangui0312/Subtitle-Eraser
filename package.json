{
  "name": "subtitle-eraser",
  "version": "1.1.2",
  "private": true,
  "description": "A simple desktop workspace for video subtitle removal",
  "author": "Subtitle Eraser",
  "repository": {
    "type": "git",
    "url": "https://github.com/sangui0312/Subtitle-Eraser.git"
  },
  "homepage": "https://github.com/sangui0312/Subtitle-Eraser#readme",
  "main": "app/main.cjs",
  "scripts": {
    "dev": "electron .",
    "test": "node --test tests/*.test.cjs",
    "smoke": "electron . --smoke",
    "verify:installer": "node --use-system-ca tools/check-installer.cjs",
    "dist:win": "electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "44.7.2",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "local.subtitleeraser.desktop",
    "productName": "SubtitleEraser",
    "beforePack": "tools/check-installer.cjs",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "app/**/*",
      "ui/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "SubtitleEraser-Setup-${version}-${arch}.${ext}",
      "icon": "build/icon.ico",
      "signAndEditExecutable": true,
      "signExecutable": false
    },
    "nsis": {
      "include": "build/installer.nsh",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "deleteAppDataOnUninstall": false,
      "installerLanguages": [
        "zh_CN",
        "en_US"
      ],
      "language": "2052"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "sangui0312",
        "repo": "Subtitle-Eraser",
        "releaseType": "release",
        "private": false
      }
    ]
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  }
}
